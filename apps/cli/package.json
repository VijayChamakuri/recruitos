{
  "name": "@recruitos/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "recruitos": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts --project cli",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "corepack pnpm test:types"
  },
  "dependencies": {
    "@recruitos/core": "workspace:*",
    "@recruitos/runtime": "workspace:*",
    "zod": "4.1.5"
  }
}
