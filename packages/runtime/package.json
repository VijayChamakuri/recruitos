      "default": "./dist/db/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js",
      "default": "./dist/entities/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js",
      "default": "./dist/commands/index.js"
    },
    "./corpus": {
      "types": "./dist/corpus/index.d.ts",
      "import": "./dist/corpus/index.js",
      "default": "./dist/corpus/index.js"
    },
