  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test": "corepack pnpm build && vitest run --root ../.. --config vitest.config.ts --project runtime",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "corepack pnpm test:types"
  },
  "dependencies": {
    "@recruitos/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.10"
  }
