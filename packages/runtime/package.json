    "./extraction": {
      "types": "./dist/extraction/index.d.ts",
      "import": "./dist/extraction/index.js",
      "default": "./dist/extraction/index.js"
    },
    "./facts": {
      "types": "./dist/facts/index.d.ts",
      "import": "./dist/facts/index.js",
      "default": "./dist/facts/index.js"
    },
    "./results": {
      "types": "./dist/results/index.d.ts",
      "import": "./dist/results/index.js",
      "default": "./dist/results/index.js"
    },
    "./resolution": {
      "types": "./dist/resolution/index.d.ts",
      "import": "./dist/resolution/index.js",
      "default": "./dist/resolution/index.js"
    },
    "./roles": {
      "types": "./dist/roles/index.d.ts",
      "import": "./dist/roles/index.js",
      "default": "./dist/roles/index.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots/index.d.ts",
      "import": "./dist/snapshots/index.js",
      "default": "./dist/snapshots/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js",
      "default": "./dist/persistence/index.js"
    }
